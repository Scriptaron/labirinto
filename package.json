{
  "name": "labirinto-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:blog": "pnpm --filter blog dev",
    "dev:all": "pnpm --parallel --filter web --filter blog dev",
    "build": "pnpm --filter web build && pnpm --filter blog build",
    "build:web": "pnpm --filter web build",
    "build:blog": "pnpm --filter blog build",
    "start": "pnpm --filter web start",
    "lint": "pnpm --filter web lint",
    "test": "pnpm --recursive test",
    "test:i18n": "pnpm --filter @labirinto/i18n-config test",
    "test:blog": "pnpm --filter blog test",
    "validate:i18n": "tsx scripts/validate-i18n.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5",
    "yaml": "^2.6.1"
  }
}
