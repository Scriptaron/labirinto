{
  "name": "labirinto-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "infisical run -- pnpm --filter web dev",
    "dev:blog": "infisical run -- pnpm --filter blog dev",
    "dev:all": "infisical run -- pnpm --parallel --filter web --filter blog dev",
    "build": "pnpm -r build",
    "lint": "pnpm --filter web lint",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.8",
    "patch-package": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vitest": "^4.0.8",
    "yaml": "^2.6.1"
  }
}