---
// Redirect client-side (estático = máximo desempenho, sem SSR)
import { defaultLang } from '../i18n/ui';
---

<!DOCTYPE html>
<html lang={defaultLang}>
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Redirecting...</title>
	<script>
		// Lógica de redirect - veja i18n/redirect.ts para testes
		const supportedLangs = ['pt', 'en', 'es'];
		
		const getCookie = (name) => {
			const value = `; ${document.cookie}`;
			const parts = value.split(`; ${name}=`);
			if (parts.length === 2) return parts.pop().split(';').shift();
			return null;
		};

		const getBrowserLang = () => {
			const browserLangs = navigator.languages || [navigator.language];
			for (const lang of browserLangs) {
				const code = lang.split('-')[0];
				if (supportedLangs.includes(code)) return code;
			}
			return 'pt';
		};

		const localeCookie = getCookie('NEXT_LOCALE');
		const targetLang = localeCookie || getBrowserLang();
		
		// Redirect imediato
		window.location.replace(`/${targetLang}/blog`);
	</script>
</head>
<body>
	<p style="text-align: center; margin-top: 50px;">Redirecting...</p>
</body>
</html>
