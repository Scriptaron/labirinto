---
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import SearchWidget from "@/components/Search/SearchWidget";
import PostHogLayout from "@/layouts/PostHogLayout.astro";
import BackToTop from "@/components/BackToTop.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { getCollection } from "astro:content";
import { useTranslations } from "@/i18n/utils";
import { categories, tags } from "@/content.config";

export async function getStaticPaths() {
    return [
        { params: { locale: "pt" } },
        { params: { locale: "en" } },
        { params: { locale: "es" } },
    ];
}

const { locale } = Astro.params;
const t = useTranslations(locale as "pt" | "en" | "es");

// Fetch ALL posts for cross-language search
const posts = (await getCollection("blog"))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .map((post) => ({
        title: post.data.title,
        description: post.data.description,
        pubDate: post.data.pubDate,
        slug: post.id,
        category: post.data.category,
        tags: post.data.tags,
        lang: post.data.lang,
        permalink: post.data.permalink,
        heroImage:
            typeof post.data.heroImage === "string"
                ? post.data.heroImage
                : post.data.heroImage?.src,
    }));

const labels = {
    searchPlaceholder: t("search.placeholder"),
    filterCategory: t("search.filter.categories"),
    filterTags: t("search.filter.tags"),
    filterDate: t("search.filter.date"),
    filterDateFrom: t("search.filter.dateFrom"),
    filterDateTo: t("search.filter.dateTo"),
    filterLanguages: t("search.filter.languages"),
    noResults: t("search.results.none"),
    resultsFound: t("search.results.found"),
    clearFilters: t("search.filters.clear"),
    readMore: t("search.readMore"),
};

const breadcrumbItems = [
    { name: "Blog", url: `/${locale}/blog` },
    { name: t("search.title") },
];
---

<PostHogLayout lang={locale}>
    <Fragment slot="head">
        <BaseHead
            title={t("search.title")}
            description={t("search.description")}
        />
    </Fragment>

    <BackToTop />
    <Header />

    <main class="w-full">
        <div class="max-w-[1440px] mx-auto relative">
            <nav
                class="w-full mx-auto px-4 sm:px-6 lg:px-8 2xl:px-16 py-3 sm:py-4"
                aria-label="Breadcrumb"
            >
                <Breadcrumbs items={breadcrumbItems} />
            </nav>

            <div class="w-full mx-auto px-4 sm:px-6 lg:px-8 2xl:px-16">
                <header class="pt-4 sm:pt-5 md:pt-6 pb-2">
                    <h1
                        class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold leading-tight mb-3 sm:mb-4 text-text"
                    >
                        {t("search.title")}
                    </h1>
                    <p
                        class="text-base sm:text-lg text-text-muted leading-relaxed mb-4 sm:mb-5 md:mb-6"
                    >
                        {t("search.description")}
                    </p>
                    <hr
                        class="w-16 sm:w-20 border-t border-border-subtle !my-0 !mt-6"
                    />
                </header>
            </div>

            <SearchWidget
                client:load
                posts={posts}
                categories={categories}
                tags={tags}
                currentLocale={locale}
                labels={labels}
            />
        </div>
    </main>
    <Footer />
</PostHogLayout>
