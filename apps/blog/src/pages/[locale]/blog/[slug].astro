---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '@/layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => {
		// Encontra posts com o mesmo slug em outros idiomas
		const alternates = { ...(post.data.alternates || {}) };
		const sameSlugPosts = posts.filter(p => 
			p.data.permalink === post.data.permalink && 
			p.data.lang !== post.data.lang
		);

		for (const p of sameSlugPosts) {
			if (!alternates[p.data.lang]) {
				alternates[p.data.lang] = p.data.permalink;
			}
		}

		const alternateLinks = Object.entries(alternates).map(([lang, slug]) => ({
			lang,
			url: `/${lang}/blog/${slug}`
		}));

		return {
			params: { 
				locale: post.data.lang,
				slug: post.data.permalink 
			},
			props: { post, alternateLinks },
		};
	});
}

type Props = { 
	post: CollectionEntry<'blog'>;
	alternateLinks: { lang: string; url: string }[];
};

const { post, alternateLinks } = Astro.props;
const { Content, headings } = await render(post);
const locale = Astro.params.locale as string;
---

	<BlogPost {...post.data} headings={headings} alternateLinks={alternateLinks} locale={locale}>
		<Content />
	</BlogPost>