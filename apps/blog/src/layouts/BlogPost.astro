---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '@/components/BaseHead.astro';
import Footer from '@/components/Footer.astro';
import FormattedDate from '@/components/FormattedDate.astro';
import Header from '@/components/Header.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import TableOfContentsMobile from '@/components/TableOfContentsMobile.astro';
import SocialShare from '@/components/SocialShare.astro';
import SocialShareFloating from '@/components/SocialShareFloating.astro';
import ReadingProgressBar from '@/components/ReadingProgressBar.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CategoryBadge from '@/components/CategoryBadge.astro';
import TagsList from '@/components/TagsList.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	headings?: { depth: number; slug: string; text: string }[];
	alternateLinks?: { lang: string; url: string }[];
	locale: 'pt' | 'en' | 'es';
};

const { title, description, pubDate, updatedDate, heroImage, headings, alternateLinks, locale, alternates, category, tags } = Astro.props;

// URL completa para compartilhamento
const currentUrl = new URL(Astro.url.pathname, Astro.site).toString();

// Breadcrumbs
const breadcrumbItems = [
  { name: 'Blog', url: `/${locale}/blog` },
  { name: title }
];
---

<html lang={locale}>
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
		{alternateLinks && alternateLinks.map(({ lang, url }) => (
			<link rel="alternate" hreflang={lang} href={url} />
		))}
		<!-- Structured Data (JSON-LD) para SEO -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "BlogPosting",
			"headline": title,
			"description": description,
			"datePublished": pubDate.toISOString(),
			"dateModified": (updatedDate || pubDate).toISOString(),
			"author": {
				"@type": "Organization",
				"name": "Labirinto"
			},
			"publisher": {
				"@type": "Organization",
				"name": "Labirinto",
				"logo": {
					"@type": "ImageObject",
					"url": new URL('/favicon.svg', Astro.site).toString()
				}
			},
			"image": heroImage ? new URL(heroImage.src, Astro.site).toString() : undefined,
			"mainEntityOfPage": {
				"@type": "WebPage",
				"@id": new URL(Astro.url.pathname, Astro.site).toString()
			},
			"inLanguage": locale
		})} />
	</head>

	<body>
		<ReadingProgressBar />
		<SocialShareFloating url={currentUrl} title={title} />
		<Header alternates={alternates} />
		<main class="w-full">
			<style>
				.hero-image-container {
					display: flex;
					justify-content: center;
					align-items: center;
				}

				.hero-image {
					display: block;
					width: 100%;
					height: auto;
					box-shadow: var(--box-shadow);
				}

				/* Mobile: full width, no rounded corners */
				@media (max-width: 1024px) {
					.hero-image-container {
						margin: 0;
						padding: 0;
					}

					.hero-image {
						border-radius: 0;
						width: 100%;
						max-width: 100%;
					}
				}

				/* Desktop: max width with rounded corners */
				@media (min-width: 1025px) {
					.hero-image {
						border-radius: 0.75rem;
						max-width: 1020px;
						margin: 0 auto;
					}
				}

				.toc-share-sidebar {
					display: flex;
					flex-direction: column;
					gap: 1.5rem;
					position: sticky;
					top: 2rem;
					align-self: flex-start;
				}

				@media (max-width: 1024px) {
					.toc-share-sidebar {
						display: none;
					}
				}

				.blog-content {
					font-size: 1rem;
					line-height: 1.75;
				}

				@media (min-width: 640px) {
					.blog-content {
						font-size: 1.0625rem;
					}
				}

				@media (min-width: 768px) {
					.blog-content {
						font-size: 1.125rem;
					}
				}

				/* ========================================
				 * TÍTULOS (H1-H6)
				 * ======================================== */
				.blog-content :global(h1),
				.blog-content :global(h2),
				.blog-content :global(h3),
				.blog-content :global(h4),
				.blog-content :global(h5),
				.blog-content :global(h6) {
					color: var(--color-text);
					font-weight: 700;
					line-height: 1.3;
					scroll-margin-top: 5rem;
				}

				.blog-content :global(h1) {
					font-size: 1.75rem;
					font-weight: 700;
					margin-top: 1.5rem;
					margin-bottom: 0.75rem;
				}

				.blog-content :global(h2) {
					font-size: 1.5rem;
					font-weight: 700;
					margin-top: 1.75rem;
					margin-bottom: 0.75rem;
				}

				.blog-content :global(h3) {
					font-size: 1.25rem;
					font-weight: 600;
					margin-top: 1.5rem;
					margin-bottom: 0.5rem;
				}

				.blog-content :global(h4) {
					font-size: 1.125rem;
					font-weight: 600;
					margin-top: 1.25rem;
					margin-bottom: 0.5rem;
				}

				.blog-content :global(h5) {
					font-size: 1rem;
					font-weight: 600;
					margin-top: 1rem;
					margin-bottom: 0.5rem;
				}

				.blog-content :global(h6) {
					font-size: 0.875rem;
					font-weight: 600;
					margin-top: 1rem;
					margin-bottom: 0.5rem;
					text-transform: uppercase;
					letter-spacing: 0.05em;
					color: var(--color-text-muted);
				}

				@media (min-width: 640px) {
					.blog-content :global(h1) {
						font-size: 2rem;
						margin-top: 1.75rem;
						margin-bottom: 0.875rem;
					}
					.blog-content :global(h2) {
						font-size: 1.75rem;
						margin-top: 2rem;
						margin-bottom: 0.875rem;
					}
					.blog-content :global(h3) {
						font-size: 1.375rem;
						margin-top: 1.75rem;
						margin-bottom: 0.625rem;
					}
					.blog-content :global(h4) {
						font-size: 1.1875rem;
						margin-top: 1.375rem;
					}
				}

				@media (min-width: 768px) {
					.blog-content :global(h1) {
						font-size: 2.5rem;
						margin-top: 2rem;
						margin-bottom: 1rem;
					}
					.blog-content :global(h2) {
						font-size: 2rem;
						margin-top: 2.5rem;
						margin-bottom: 1rem;
					}
					.blog-content :global(h3) {
						font-size: 1.5rem;
						margin-top: 2rem;
						margin-bottom: 0.75rem;
					}
					.blog-content :global(h4) {
						font-size: 1.25rem;
						margin-top: 1.5rem;
					}
				}

				/* ========================================
				 * PARÁGRAFOS
				 * ======================================== */
				.blog-content :global(p) {
					color: var(--color-text);
					margin-bottom: 1.25rem;
					line-height: 1.7;
				}

				@media (min-width: 640px) {
					.blog-content :global(p) {
						margin-bottom: 1.375rem;
						line-height: 1.75;
					}
				}

				@media (min-width: 768px) {
					.blog-content :global(p) {
						margin-bottom: 1.5rem;
						line-height: 1.8;
					}
				}

				/* ========================================
				 * LINKS
				 * ======================================== */
				.blog-content :global(a) {
					color: var(--color-blog-highlight);
					text-decoration: none;
					border-bottom: 1px solid transparent;
					transition: all 0.2s ease;
					font-weight: 500;
				}

				.blog-content :global(a:hover) {
					color: var(--color-blog-highlight-hover);
					border-bottom-color: var(--color-blog-highlight-hover);
				}

				.blog-content :global(a:focus-visible) {
					outline: 2px solid var(--color-blog-highlight);
					outline-offset: 2px;
					border-radius: 0.125rem;
				}

				/* ========================================
				 * NEGRITO E ITÁLICO
				 * ======================================== */
				.blog-content :global(strong) {
					font-weight: 700;
					color: var(--color-text);
				}

				.blog-content :global(em) {
					font-style: italic;
					color: var(--color-text);
				}

				.blog-content :global(strong em),
				.blog-content :global(em strong) {
					font-weight: 700;
					font-style: italic;
				}

				/* ========================================
				 * STRIKETHROUGH
				 * ======================================== */
				.blog-content :global(del),
				.blog-content :global(s) {
					text-decoration: line-through;
					color: var(--color-text-muted);
					opacity: 0.7;
				}
				/* ========================================
				* CÓDIGO INLINE (dentro de texto)
				* ======================================== */
				.blog-content :global(:not(pre) > code) {
					background-color: var(--color-surface);
					color: var(--color-blog-highlight);
					padding: 0.2rem 0.4rem;
					border-radius: 0.25rem;
					font-size: 0.9em;
					font-family: 'Courier New', Consolas, Monaco, monospace;
					border: 1px solid var(--color-border-subtle);
					font-weight: 500;
				}

				/* ========================================
				* BLOCOS DE CÓDIGO COM SHIKI
				* ======================================== */

				/* Container do bloco de código */
				.blog-content :global(pre) {
					padding: 1.5rem;
					border-radius: 0.5rem;
					overflow-x: auto;
					margin: 1.5rem 0;
					box-shadow: var(--shadow-sm);
					border: 1px solid var(--color-border);
				}

				/* Código dentro do pre */
				.blog-content :global(pre code) {
					padding: 0 !important;
					border-radius: 0 !important;
					font-size: 0.95rem !important;
					border: none !important;
					background: none !important;
					color: inherit !important;
					font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
					line-height: 1.7;
				}

				/* Tema escuro do Shiki - prefers-color-scheme */
				@media (prefers-color-scheme: dark) {
					:global(:root:not([data-theme='light'])) .blog-content :global(pre.astro-code),
					:global(:root:not([data-theme='light'])) .blog-content :global(pre.astro-code span) {
						color: var(--shiki-dark) !important;
						background-color: var(--shiki-dark-bg) !important;
					}
				}

				/* Tema escuro do Shiki - data-theme */
				:global([data-theme='dark']) .blog-content :global(pre.astro-code),
				:global([data-theme='dark']) .blog-content :global(pre.astro-code span) {
					color: var(--shiki-dark) !important;
					background-color: var(--shiki-dark-bg) !important;
				}

				/* Ajustes para mobile */
				@media (min-width: 768px) {
					.blog-content :global(pre) {
						padding: 2rem;
						border-radius: 0.75rem;
					}
				}

				/* Scrollbar customizada para blocos de código */
				.blog-content :global(pre)::-webkit-scrollbar {
					height: 8px;
				}

				.blog-content :global(pre)::-webkit-scrollbar-track {
					background: rgba(0, 0, 0, 0.1);
					border-radius: 4px;
				}

				.blog-content :global(pre)::-webkit-scrollbar-thumb {
					background: rgba(0, 0, 0, 0.3);
					border-radius: 4px;
				}

				.blog-content :global(pre)::-webkit-scrollbar-thumb:hover {
					background: rgba(0, 0, 0, 0.5);
				}

				/* Scrollbar dark mode */
				@media (prefers-color-scheme: dark) {
					.blog-content :global(pre)::-webkit-scrollbar-track {
						background: rgba(255, 255, 255, 0.1);
					}
					
					.blog-content :global(pre)::-webkit-scrollbar-thumb {
						background: rgba(255, 255, 255, 0.3);
					}
					
					.blog-content :global(pre)::-webkit-scrollbar-thumb:hover {
						background: rgba(255, 255, 255, 0.5);
					}
				}

				:global([data-theme='dark']) .blog-content :global(pre)::-webkit-scrollbar-track {
					background: rgba(255, 255, 255, 0.1);
				}

				:global([data-theme='dark']) .blog-content :global(pre)::-webkit-scrollbar-thumb {
					background: rgba(255, 255, 255, 0.3);
				}

				:global([data-theme='dark']) .blog-content :global(pre)::-webkit-scrollbar-thumb:hover {
					background: rgba(255, 255, 255, 0.5);
				}

				/* ========================================
				 * CITAÇÕES (BLOCKQUOTE)
				 * ======================================== */
				.blog-content :global(blockquote) {
					border-left: 4px solid var(--color-blog-highlight);
					padding-left: 1.5rem;
					padding-top: 0.5rem;
					padding-bottom: 0.5rem;
					margin: 1.5rem 0;
					font-style: italic;
					color: var(--color-text-muted);
					background-color: var(--color-surface);
					border-radius: 0 0.375rem 0.375rem 0;
				}

				.blog-content :global(blockquote p) {
					margin-bottom: 0.5rem;
				}

				.blog-content :global(blockquote p:last-child) {
					margin-bottom: 0;
				}

				@media (min-width: 768px) {
					.blog-content :global(blockquote) {
						padding-left: 2rem;
						padding-top: 0.75rem;
						padding-bottom: 0.75rem;
						margin: 2rem 0;
					}
				}

				/* ========================================
				 * LISTAS (UL/OL)
				 * ======================================== */
				.blog-content :global(ul),
				.blog-content :global(ol) {
					margin: 1rem 0;
					padding-left: 1.5rem;
					color: var(--color-text);
				}

				.blog-content :global(li) {
					margin-bottom: 0.5rem;
					line-height: 1.7;
				}

				.blog-content :global(ul) {
					list-style-type: disc;
				}

				.blog-content :global(ul ul) {
					list-style-type: circle;
					margin-top: 0.5rem;
				}

				.blog-content :global(ul ul ul) {
					list-style-type: square;
				}

				.blog-content :global(ol) {
					list-style-type: decimal;
				}

				.blog-content :global(ol ol) {
					list-style-type: lower-alpha;
					margin-top: 0.5rem;
				}

				.blog-content :global(ol ol ol) {
					list-style-type: lower-roman;
				}

				.blog-content :global(li > p) {
					margin-bottom: 0.5rem;
				}

				@media (min-width: 640px) {
					.blog-content :global(ul),
					.blog-content :global(ol) {
						margin: 1.25rem 0;
						padding-left: 1.75rem;
					}
				}

				@media (min-width: 768px) {
					.blog-content :global(ul),
					.blog-content :global(ol) {
						margin: 1.5rem 0;
						padding-left: 2rem;
					}
				}

				/* ========================================
				 * LIST MARKERS (Bullets & Numbers)
				 * ======================================== */
				.blog-content :global(li::marker) {
					color: var(--color-blog-highlight);
					font-weight: 600;
				}

				.blog-content :global(li:hover::marker) {
					color: var(--color-blog-highlight-hover);
				}

				/* ========================================
				 * TASK LISTS (CHECKBOXES)
				 * ======================================== */
				.blog-content :global(ul.contains-task-list),
				.blog-content :global(ul:has(input[type="checkbox"])) {
					list-style-type: none;
					padding-left: 0;
				}

				.blog-content :global(li.task-list-item),
				.blog-content :global(li:has(> input[type="checkbox"])) {
					display: flex;
					align-items: flex-start;
					gap: 0.5rem;
				}

				.blog-content :global(input[type="checkbox"]) {
					margin-top: 0.35rem;
					width: 1rem;
					height: 1rem;
					cursor: pointer;
					accent-color: var(--color-blog-highlight);
					flex-shrink: 0;
				}

				/* ========================================
				 * IMAGENS
				 * ======================================== */
				.blog-content :global(img) {
					border-radius: 0.5rem;
					box-shadow: var(--shadow-md);
					margin: 1.5rem 0;
					max-width: 100%;
					height: auto;
					border: 1px solid var(--color-border-subtle);
				}

				@media (min-width: 768px) {
					.blog-content :global(img) {
						margin: 2rem 0;
						border-radius: 0.75rem;
					}
				}

				/* ========================================
				 * LINHA HORIZONTAL
				 * ======================================== */
				.blog-content :global(hr) {
					border: none;
					border-top: 2px solid var(--color-border);
					margin: 2rem 0;
					opacity: 0.5;
				}

				@media (min-width: 640px) {
					.blog-content :global(hr) {
						margin: 2.5rem 0;
					}
				}

				@media (min-width: 768px) {
					.blog-content :global(hr) {
						margin: 3rem 0;
					}
				}

				/* ========================================
				 * TABELAS
				 * ======================================== */
				.blog-content :global(table) {
					width: 100%;
					border-collapse: collapse;
					margin: 1.5rem 0;
					background-color: var(--color-surface);
					border-radius: 0.5rem;
					overflow: hidden;
					box-shadow: var(--shadow-sm);
				}



				.blog-content :global(th),
				.blog-content :global(td) {
					padding: 0.75rem;
				}

				.blog-content :global(th) {
					padding: 0.75rem 1rem;
					text-align: left;
					font-weight: 800;
					color: var(--color-text);
					background-color: rgba(0, 0, 0, 0.04);
					border-bottom: 2px solid var(--color-border);
					border-right: 1px solid var(--neutral-300);
					text-transform: uppercase;
					font-size: 0.85rem;
					letter-spacing: 0.05em;
				}

				:global([data-theme='dark']) .blog-content :global(th) {
					background-color: rgba(255, 255, 255, 0.04);
				}

				.blog-content :global(th:last-child) {
					border-right: none;
				}

				.blog-content :global(td) {
					padding: 0.75rem 1rem;
					border-top: 1px solid var(--neutral-300);
					border-right: 1px solid var(--neutral-300);
					color: var(--color-text);
				}

				.blog-content :global(td:last-child) {
					border-right: none;
				}

				:global([data-theme='dark']) .blog-content :global(td),
				:global([data-theme='dark']) .blog-content :global(th) {
					border-color: var(--neutral-900);
				}

				.blog-content :global(tbody tr:hover) {
					background-color: color-mix(in srgb, var(--color-blog-highlight) 8%, transparent);
				}

				:global([data-theme='dark']) .blog-content :global(tbody tr:hover) {
					background-color: color-mix(in srgb, var(--color-blog-highlight) 10%, transparent);
				}

				@media (min-width: 768px) {
					.blog-content :global(th),
					.blog-content :global(td) {
						padding: 1rem 1.25rem;
					}
				}

				/* Tabelas responsivas em mobile */
				@media (max-width: 640px) {
					.blog-content :global(table) {
						display: block;
						overflow-x: auto;
						white-space: nowrap;
					}
				}

				/* ========================================
				 * FOOTNOTES
				 * ======================================== */
				.blog-content :global(.footnotes) {
					margin-top: 3rem;
					padding-top: 2rem;
					border-top: 2px solid var(--color-border);
					font-size: 0.875rem;
					color: var(--color-text-muted);
				}

				.blog-content :global(.footnotes ol) {
					padding-left: 1.5rem;
				}

				.blog-content :global(.footnote-ref) {
					color: var(--color-blog-highlight);
					text-decoration: none;
					font-weight: 600;
				}

				.blog-content :global(.footnote-ref:hover) {
					color: var(--color-blog-highlight-hover);
				}

				.blog-content :global(.footnote-backref) {
					color: var(--color-blog-highlight);
					text-decoration: none;
					margin-left: 0.25rem;
				}

				/* ========================================
				 * QUEBRAS DE LINHA
				 * ======================================== */
				.blog-content :global(br) {
					display: block;
					content: "";
					margin-top: 0.5rem;
				}

				/* ========================================
				 * HIGHLIGHT (MARK)
				 * ======================================== */
				.blog-content :global(mark) {
					background-color: var(--accent-light);
					color: var(--neutral-900);
					padding: 0.1rem 0.3rem;
					border-radius: 0.2rem;
				}

				:global([data-theme='dark']) .blog-content :global(mark) {
					background-color: var(--accent);
					color: var(--neutral-900);
				}

				/* ========================================
				 * KBD
				 * ======================================== */
				.blog-content :global(kbd) {
					background-color: var(--neutral-100);
					border: 1px solid var(--neutral-300);
					border-radius: 0.25rem;
					padding: 0.1rem 0.3rem;
					font-family: monospace;
					font-size: 0.85em;
					box-shadow: 0 1px 0 var(--neutral-300);
					color: var(--color-text);
				}

				:global([data-theme='dark']) .blog-content :global(kbd) {
					background-color: var(--neutral-800);
					border-color: var(--neutral-600);
					box-shadow: 0 1px 0 var(--neutral-600);
					color: var(--neutral-100);
				}

				/* ========================================
				 * TABLE ZEBRA STRIPING
				 * ======================================== */
				.blog-content :global(tr:nth-child(even)) {
					background-color: rgba(0, 0, 0, 0.02);
				}

				:global([data-theme='dark']) .blog-content :global(tr:nth-child(even)) {
					background-color: rgba(255, 255, 255, 0.06);
				}
			</style>
			<article>
				<div class="max-w-[1200px] mx-auto relative">
					<div class="w-full mx-auto px-4 sm:px-6 py-3 sm:py-4">
						<Breadcrumbs items={breadcrumbItems} />
					</div>
					<div class="w-full mx-auto px-4 sm:px-6 lg:px-0 lg:max-w-[1020px]">
						<div class="py-4 sm:py-5 md:py-6">
							<div class="mb-3 sm:mb-3.5 md:mb-4 text-xs uppercase tracking-wider text-text-muted font-semibold flex items-center gap-3 flex-wrap">
								{category && (
									<>
										<CategoryBadge category={category} locale={locale} />
										<span class="text-text-muted">•</span>
									</>
								)}
								<div class="flex items-center gap-2">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
									</svg>
									<FormattedDate date={pubDate} />
								</div>
								{
									updatedDate && (
										<div class="italic normal-case text-[0.7rem] font-medium">
											• Atualizado em <FormattedDate date={updatedDate} />
										</div>
									)
								}
							</div>
							<h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold leading-tight mb-3 sm:mb-4">{title}</h1>
							{description && (
								<p class="text-base sm:text-lg text-text-muted leading-relaxed mb-4 sm:mb-5 md:mb-6">{description}</p>
							)}
							<hr class="w-16 sm:w-20 border-t" />
						</div>
					</div>
					{heroImage && (
						<div class="hero-image-container mb-8 lg:mb-12">
							<Image
								class="hero-image"
								width={1020}
								height={510}
								src={heroImage}
								alt={title}
							/>
						</div>
					)}
					<TableOfContentsMobile />
					<div class="flex gap-6 lg:gap-10 xl:gap-12 items-start">
						<div class="toc-share-sidebar">
							<TableOfContents />
							<SocialShare url={currentUrl} title={title} />
						</div>
						<div class="flex-1 max-w-full lg:max-w-[720px] min-w-0 blog-content">
							<slot />
							{tags && tags.length > 0 && (
								<div class="mt-12 pt-6 border-t border-border">
									<TagsList tags={tags} locale={locale} />
								</div>
							)}
						</div>
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
	<script>
		function handleExternalLinks() {
			const links = document.querySelectorAll('.blog-content a');
			const currentHost = window.location.hostname;

			links.forEach(link => {
				try {
					// Check if it's a valid URL
					const url = new URL(link.href);
					
					// If hostname is different and not a mailto/tel link
					if (url.hostname !== currentHost && !link.href.startsWith('mailto:') && !link.href.startsWith('tel:')) {
						link.setAttribute('target', '_blank');
						link.setAttribute('rel', 'noopener noreferrer');
						
						// Optional: Add an external link icon or indicator class
						link.classList.add('external-link');
					}
				} catch (e) {
					// Invalid URL, ignore
				}
			});
		}

		// Run on load and after Astro page transitions
		document.addEventListener('DOMContentLoaded', handleExternalLinks);
		document.addEventListener('astro:page-load', handleExternalLinks);
	</script>
</html>
