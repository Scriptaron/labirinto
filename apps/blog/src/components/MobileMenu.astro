---
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

interface Props {
  alternates?: Record<string, string>;
}

const { alternates } = Astro.props;
const locale = getLangFromUrl(Astro.url);
const t = useTranslations(locale);

const localeNames = {
  pt: 'Português',
  en: 'English',
  es: 'Español',
} as const;

const LOCALE_COOKIE_NAME = 'NEXT_LOCALE';
const currentPath = Astro.url.pathname.replace(/^\/[a-z]{2}\//, '/');
---

<div id="mobile-menu-overlay" class="mobile-menu-overlay">
	<div id="mobile-menu" class="mobile-menu">
		<div class="mobile-menu-header">
			<h2 class="mobile-menu-logo">{t('site.title')}</h2>
			<button id="mobile-menu-close" class="mobile-menu-close" aria-label="Fechar menu">
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<line x1="18" y1="6" x2="6" y2="18"></line>
					<line x1="6" y1="6" x2="18" y2="18"></line>
				</svg>
			</button>
		</div>

		<nav class="mobile-menu-nav">
			<a href={`/${locale}/blog`} class="mobile-menu-link">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
				</svg>
				{t('nav.blog')}
			</a>

			<hr class="mobile-menu-divider" />

			<div class="mobile-menu-section">
				<span class="mobile-menu-section-title">{t('language.label')}</span>
				<div class="mobile-menu-options" data-cookie-name={LOCALE_COOKIE_NAME}>
					{Object.entries(localeNames).map(([loc, name]) => {
						let href = `/${loc}${currentPath}`;
						
						if (alternates && alternates[loc]) {
							href = `/${loc}/blog/${alternates[loc]}`;
						} else if (alternates && loc === locale) {
							href = Astro.url.pathname;
						} else if (currentPath.includes('/blog/')) {
							href = `/${loc}/blog`;
						}
						
						return (
							<a
								href={href}
								class={`mobile-menu-option ${loc === locale ? 'active' : ''}`}
								data-locale={loc}
							>
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<circle cx="12" cy="12" r="10"/>
									<path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
									<path d="M2 12h20"/>
								</svg>
								{name}
							</a>
						);
					})}
				</div>
			</div>

			<div class="mobile-menu-section">
				<span class="mobile-menu-section-title">Tema</span>
				<button id="mobile-theme-toggle" class="mobile-menu-option" type="button">
					<svg id="mobile-sun-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<circle cx="12" cy="12" r="5"></circle>
						<line x1="12" y1="1" x2="12" y2="3"></line>
						<line x1="12" y1="21" x2="12" y2="23"></line>
						<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
						<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
						<line x1="1" y1="12" x2="3" y2="12"></line>
						<line x1="21" y1="12" x2="23" y2="12"></line>
						<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
						<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
					</svg>
					<svg id="mobile-moon-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
					</svg>
					<span id="mobile-theme-text">Claro</span>
				</button>
			</div>
		</nav>
	</div>
</div>

<style is:global>
	.mobile-menu-overlay {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: rgba(0, 0, 0, 0.5);
		z-index: 1000;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.3s ease;
	}

	.mobile-menu-overlay.open {
		opacity: 1;
		pointer-events: auto;
	}

	.mobile-menu {
		position: fixed;
		top: 0;
		left: 0;
		bottom: 0;
		width: 85%;
		max-width: 320px;
		background: #1a1a1a;
		transform: translateX(-100%);
		transition: transform 0.3s ease;
		overflow-y: auto;
		box-shadow: 4px 0 12px rgba(0, 0, 0, 0.3);
	}

	:root:not([data-theme="dark"]) .mobile-menu {
		background: var(--color-surface);
	}

	.mobile-menu-overlay.open .mobile-menu {
		transform: translateX(0);
	}

	.mobile-menu-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1.5rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
	}

	:root:not([data-theme="dark"]) .mobile-menu-header {
		border-bottom-color: var(--color-border);
	}

	.mobile-menu-logo {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 700;
		color: white;
	}

	:root:not([data-theme="dark"]) .mobile-menu-logo {
		color: var(--color-text);
	}

	.mobile-menu-close {
		width: 2.5rem;
		height: 2.5rem;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(255, 255, 255, 0.1);
		border: none;
		border-radius: 0.5rem;
		color: white;
		cursor: pointer;
		transition: all 0.2s ease;
	}

	:root:not([data-theme="dark"]) .mobile-menu-close {
		background: var(--color-border-subtle);
		color: var(--color-text);
	}

	.mobile-menu-close:hover {
		background: rgba(255, 255, 255, 0.15);
		transform: scale(1.05);
	}

	:root:not([data-theme="dark"]) .mobile-menu-close:hover {
		background: var(--color-border);
	}

	.mobile-menu-nav {
		padding: 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.mobile-menu-link {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 1rem;
		text-decoration: none;
		font-size: 1rem;
		font-weight: 500;
		border-radius: 0.75rem;
		transition: all 0.2s ease;
		color: #d1d5db;
		background: rgba(255, 255, 255, 0.03);
	}

	:root:not([data-theme="dark"]) .mobile-menu-link {
		color: var(--color-text);
		background: var(--color-border-subtle);
	}

	.mobile-menu-link:hover {
		background: rgba(255, 255, 255, 0.08);
		color: white;
	}

	:root:not([data-theme="dark"]) .mobile-menu-link:hover {
		background: var(--color-border);
	}

	.mobile-menu-divider {
		border: none;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
		margin: 0.5rem 0;
	}

	:root:not([data-theme="dark"]) .mobile-menu-divider {
		border-top-color: var(--color-border);
	}

	.mobile-menu-section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.mobile-menu-section-title {
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: #9ca3af;
		padding: 0.5rem 1rem 0;
	}

	:root:not([data-theme="dark"]) .mobile-menu-section-title {
		color: var(--color-text-muted);
	}

	.mobile-menu-options {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.mobile-menu-option {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.875rem 1rem;
		text-decoration: none;
		font-size: 0.9375rem;
		border-radius: 0.5rem;
		transition: all 0.2s ease;
		color: #9ca3af;
		background: rgba(255, 255, 255, 0.03);
		border: none;
		width: 100%;
		text-align: left;
		cursor: pointer;
	}

	:root:not([data-theme="dark"]) .mobile-menu-option {
		color: var(--color-text-muted);
		background: var(--color-border-subtle);
	}

	.mobile-menu-option:hover {
		color: #d1d5db;
		background: rgba(255, 255, 255, 0.05);
	}

	:root:not([data-theme="dark"]) .mobile-menu-option:hover {
		color: var(--color-text);
		background: var(--color-border);
	}

	.mobile-menu-option.active {
		color: var(--accent-dark);
		background: color-mix(in srgb, var(--accent-dark) 15%, transparent);
		font-weight: 600;
	}

	:root:not([data-theme="dark"]) .mobile-menu-option.active {
		color: var(--primary);
		background: color-mix(in srgb, var(--primary) 12%, transparent);
	}

	/* Theme toggle icons */
	#mobile-sun-icon,
	#mobile-moon-icon {
		position: absolute;
		transition: all 0.3s ease;
	}

	#mobile-sun-icon {
		opacity: 1;
		transform: rotate(0deg) scale(1);
	}

	#mobile-moon-icon {
		opacity: 0;
		transform: rotate(180deg) scale(0.5);
	}

	[data-theme='dark'] #mobile-sun-icon {
		opacity: 0;
		transform: rotate(-180deg) scale(0.5);
	}

	[data-theme='dark'] #mobile-moon-icon {
		opacity: 1;
		transform: rotate(0deg) scale(1);
	}

	#mobile-theme-text {
		margin-left: 1.5rem;
	}
</style>

<script is:inline>
	function initMobileMenu() {
		const menuButton = document.getElementById('mobile-menu-button');
		const menuOverlay = document.getElementById('mobile-menu-overlay');
		const menuClose = document.getElementById('mobile-menu-close');
		const themeToggle = document.getElementById('mobile-theme-toggle');
		const themeText = document.getElementById('mobile-theme-text');

		if (!menuButton || !menuOverlay || !menuClose) return;

		// Open menu
		menuButton.addEventListener('click', () => {
			menuOverlay.classList.add('open');
			document.body.style.overflow = 'hidden';
		});

		// Close menu
		const closeMenu = () => {
			menuOverlay.classList.remove('open');
			document.body.style.overflow = '';
		};

		menuClose.addEventListener('click', closeMenu);
		menuOverlay.addEventListener('click', (e) => {
			if (e.target === menuOverlay) {
				closeMenu();
			}
		});

		// Theme toggle
		if (themeToggle && themeText) {
			const updateThemeText = () => {
				const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
				themeText.textContent = currentTheme === 'dark' ? 'Escuro' : 'Claro';
			};

			themeToggle.addEventListener('click', () => {
				const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
				const newTheme = currentTheme === 'light' ? 'dark' : 'light';
				
				document.documentElement.setAttribute('data-theme', newTheme);
				if (document.body) {
					document.body.setAttribute('data-theme', newTheme);
				}
				try {
					localStorage.setItem('theme', newTheme);
				} catch (e) {
					console.warn('Não foi possível salvar o tema:', e);
				}
				
				updateThemeText();
			});

			updateThemeText();
		}

		// Language switcher
		const languageOptions = document.querySelectorAll('.mobile-menu-option[data-locale]');
		const cookieName = document.querySelector('.mobile-menu-options')?.getAttribute('data-cookie-name');
		
		languageOptions.forEach(option => {
			option.addEventListener('click', (e) => {
				const target = e.currentTarget;
				const locale = target && target.getAttribute('data-locale');
				if (locale && cookieName) {
					const expires = new Date();
					expires.setFullYear(expires.getFullYear() + 1);
					document.cookie = `${cookieName}=${locale}; path=/; expires=${expires.toUTCString()}`;
				}
			});
		});

		// Close menu on navigation
		const menuLinks = menuOverlay.querySelectorAll('a');
		menuLinks.forEach(link => {
			link.addEventListener('click', closeMenu);
		});
	}

	document.addEventListener('DOMContentLoaded', initMobileMenu);
	document.addEventListener('astro:page-load', initMobileMenu);
</script>
