---

<button
    id="back-to-top-btn"
    class="back-to-top-button fixed right-4 bottom-5 z-[999] w-12 h-12 rounded-lg shadow-lg hover:shadow-xl flex items-center justify-center border-none cursor-pointer"
    aria-label="Voltar ao topo"
>
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 15l-6-6-6 6"/>
    </svg>
</button>

<style is:global>
    .back-to-top-button {
        background: var(--color-primary) !important;
        color: var(--color-text-on-primary) !important;
        
        /* Initial state: hidden and scaled down */
        opacity: 0;
        pointer-events: none;
        transform: scale(0.5);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .back-to-top-button:hover {
        background: var(--color-primary-hover) !important;
        transform: scale(1.1) !important; /* Scale effect on hover when visible */
    }

    :root[data-theme='dark'] .back-to-top-button,
    html[data-theme='dark'] .back-to-top-button {
        background: var(--accent-dark) !important;
        color: white !important;
    }

    :root[data-theme='dark'] .back-to-top-button:hover,
    html[data-theme='dark'] .back-to-top-button:hover {
        background: var(--accent) !important;
    }
    
    .back-to-top-button.visible {
        opacity: 1;
        pointer-events: auto;
        transform: scale(1) !important;
    }
    
    /* Maintain hover scale when visible */
    .back-to-top-button.visible:hover {
        transform: scale(1.1) !important;
    }
</style>

<script>
    function initBackToTop() {
        const btn = document.getElementById('back-to-top-btn');
        
        if (!btn) return;

        let lastScrollTop = 0;
        const threshold = 300; // Show after scrolling this amount

        const handleScroll = () => {
            const scrollTop = window.scrollY || document.documentElement.scrollTop;
            
            // Prevent negative scroll values (e.g. mobile bounce)
            if (scrollTop < 0) return;

            // Logic:
            // 1. If we are near the top (less than threshold), always hide
            // 2. If we are scrolling UP and past threshold, show
            // 3. If we are scrolling DOWN, hide
            
            if (scrollTop < threshold) {
                btn.classList.remove('visible');
            } else {
                if (scrollTop < lastScrollTop) {
                    // Scrolling UP
                    btn.classList.add('visible');
                } else {
                    // Scrolling DOWN
                    btn.classList.remove('visible');
                }
            }
            
            lastScrollTop = scrollTop;
        };

        const scrollToTop = () => {
            window.scrollTo({
                top: 0,
                behavior: 'smooth'
            });
        };

        window.addEventListener('scroll', handleScroll, { passive: true });
        btn.addEventListener('click', scrollToTop);
    }

    document.addEventListener('DOMContentLoaded', initBackToTop);
    document.addEventListener('astro:page-load', initBackToTop);
</script>
