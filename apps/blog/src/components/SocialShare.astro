<style is:global>
	.share-modal-link {
		border: 2px solid var(--color-border);
		background: var(--color-surface);
		color: var(--color-text);
		transition: background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
	}

	:root[data-theme='dark'] .share-modal-link {
		background: rgba(255, 255, 255, 0.04);
		border-color: rgba(255, 255, 255, 0.12);
	}

	.share-modal-link:hover {
		background: var(--color-border-subtle);
		border-color: var(--color-border);
	}

	:root[data-theme='dark'] .share-modal-link:hover {
		background: rgba(255, 255, 255, 0.08);
		border-color: rgba(255, 255, 255, 0.2);
	}

	#share-modal-close:hover {
		color: var(--color-text) !important;
	}

	#copy-link-btn-input:hover {
		filter: brightness(1.1);
	}
</style>

<script>
	function initSocialShare() {
		const moreBtn = document.getElementById('share-more-btn');
		const moreBtnMobile = document.getElementById('share-mobile-more-btn');
		const modal = document.getElementById('share-modal');
		const modalOverlay = document.getElementById('share-modal-overlay');
		const closeBtn = document.getElementById('share-modal-close');

		if (!modal || !modalOverlay || !closeBtn) return;

		// Abrir modal
		const openModal = () => {
			modal.setAttribute('aria-hidden', 'false');
			document.body.style.overflow = 'hidden';
			// Aplicar blur e overlay na barra de progresso
			const progressBar = document.getElementById('reading-progress-container');
			if (progressBar) {
				progressBar.style.backdropFilter = 'blur(4px)';
				progressBar.style.webkitBackdropFilter = 'blur(4px)';
				progressBar.classList.add('modal-open');
			}
		};

		if (moreBtn) {
			moreBtn.addEventListener('click', openModal);
		}

		if (moreBtnMobile) {
			moreBtnMobile.addEventListener('click', openModal);
		}

		// Fechar modal
		const closeModal = () => {
			modal.setAttribute('aria-hidden', 'true');
			document.body.style.overflow = '';
			// Remover blur e overlay da barra de progresso
			const progressBar = document.getElementById('reading-progress-container');
			if (progressBar) {
				progressBar.style.backdropFilter = '';
				progressBar.style.webkitBackdropFilter = '';
				progressBar.classList.remove('modal-open');
			}
		};

		closeBtn.addEventListener('click', closeModal);
		modalOverlay.addEventListener('click', closeModal);

		// Fechar com ESC
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && modal.getAttribute('aria-hidden') === 'false') {
				closeModal();
			}
		});

		// Copiar link do input
		const copyBtnInput = document.getElementById('copy-link-btn-input');
		if (copyBtnInput) {
			copyBtnInput.addEventListener('click', async () => {
				const url = copyBtnInput.getAttribute('data-url');
				if (!url) return;

				try {
					await navigator.clipboard.writeText(url);
					const span = copyBtnInput.querySelector('.copy-btn-text');
					const originalText = span?.textContent;
					if (span) {
						span.textContent = 'Copiado!';
						copyBtnInput.classList.add('copied');
						setTimeout(() => {
							span.textContent = originalText || 'Copiar';
							copyBtnInput.classList.remove('copied');
						}, 2000);
					}
				} catch (err) {
					console.error('Erro ao copiar:', err);
				}
			});
		}

		// Tracking de compartilhamento
		document.querySelectorAll('[data-platform]').forEach(btn => {
			btn.addEventListener('click', () => {
				const platform = btn.getAttribute('data-platform');
				console.log('Compartilhado em:', platform);
			});
		});
	}

	document.addEventListener('DOMContentLoaded', initSocialShare);
	document.addEventListener('astro:page-load', initSocialShare);
</script>
