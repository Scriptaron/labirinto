---
interface Props {
	url: string;
	title: string;
}

const { url, title } = Astro.props;

const shareUrl = url;
---

<div class="pt-4 border-t border-gray-200 dark:border-gray-700">
	<div class="flex gap-3 items-center justify-center">
		<!-- WhatsApp -->
		<a 
			href={`https://wa.me/?text=${encodeURIComponent(title + ' ' + shareUrl + '?utm_source=whatsapp&utm_medium=social&utm_campaign=share')}`}
			target="_blank"
			rel="noopener noreferrer"
			class="relative flex items-center justify-center w-11 h-11 rounded-lg bg-[#25D366] hover:bg-[#2ee673] text-white transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg no-underline"
			aria-label="Compartilhar no WhatsApp"
			data-platform="whatsapp"
			title="Compartilhar no WhatsApp"
		>
			<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="block mx-auto">
				<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
			</svg>
		</a>

		<!-- Instagram -->
		<a 
			href={`https://www.instagram.com/?url=${encodeURIComponent(shareUrl + '?utm_source=instagram&utm_medium=social&utm_campaign=share')}`}
			target="_blank"
			rel="noopener noreferrer"
			class="relative flex items-center justify-center w-11 h-11 rounded-lg bg-gradient-to-br from-[#f09433] via-[#dc2743] to-[#bc1888] hover:from-[#f5a142] hover:via-[#e63050] hover:to-[#c72595] text-white transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg no-underline"
			aria-label="Compartilhar no Instagram"
			data-platform="instagram"
			title="Compartilhar no Instagram"
		>
			<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="block mx-auto">
				<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
			</svg>
		</a>

		<!-- Twitter/X -->
		<a 
			href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(shareUrl + '?utm_source=twitter&utm_medium=social&utm_campaign=share')}&text=${encodeURIComponent(title)}`}
			target="_blank"
			rel="noopener noreferrer"
			class="relative flex items-center justify-center w-11 h-11 rounded-lg bg-black hover:bg-gray-800 text-white transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg no-underline"
			aria-label="Compartilhar no Twitter"
			data-platform="twitter"
			title="Compartilhar no Twitter"
		>
			<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="block mx-auto">
				<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
			</svg>
		</a>

		<!-- Botão Compartilhar (Mais opções) -->
		<button 
			class="relative flex items-center justify-center w-11 h-11 rounded-lg bg-gradient-to-br from-[#667eea] to-[#764ba2] hover:from-[#7c8ff0] hover:to-[#8a5bb5] text-white transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg border-none cursor-pointer"
			aria-label="Mais opções de compartilhamento"
			id="share-more-btn"
			title="Mais opções"
		>
			<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="block mx-auto">
				<circle cx="18" cy="5" r="3"></circle>
				<circle cx="6" cy="12" r="3"></circle>
				<circle cx="18" cy="19" r="3"></circle>
				<line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
				<line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
			</svg>

		</button>
	</div>
</div>

<!-- Modal de compartilhamento -->
<div id="share-modal" class="fixed inset-0 z-[9999] flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300 [&[aria-hidden='false']]:opacity-100 [&[aria-hidden='false']]:pointer-events-auto" aria-hidden="true">
	<div class="absolute inset-0 bg-black/70 backdrop-blur-sm" id="share-modal-overlay"></div>
	<div class="share-modal-content relative rounded-2xl max-w-[640px] w-[calc(100%-2rem)] max-h-[80vh] overflow-hidden shadow-2xl scale-95 transition-transform duration-300 [.opacity-100_&]:scale-100" style="background: var(--color-surface); border: 1px solid var(--color-border);">
		<div class="flex items-center justify-between p-6" style="border-bottom: 1px solid var(--color-border);">
			<h3 class="m-0 text-xl font-semibold" style="color: var(--color-text);">Compartilhar</h3>
			<button class="flex items-center justify-center p-2 bg-transparent border-none cursor-pointer transition-colors" style="color: var(--color-text-muted);" id="share-modal-close" aria-label="Fechar">
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<line x1="18" y1="6" x2="6" y2="18"></line>
					<line x1="6" y1="6" x2="18" y2="18"></line>
				</svg>
			</button>
		</div>
		<div class="p-6 overflow-y-auto max-h-[calc(80vh-80px)]">
			<!-- Seção de Link -->
			<div class="mb-6 pb-6" style="border-bottom: 1px solid var(--color-border);">
				<label for="share-url-input" class="block text-sm font-semibold mb-2" style="color: var(--color-text);">Link do Post</label>
				<div class="flex gap-2 items-stretch">
					<input 
						type="text" 
						id="share-url-input" 
						class="flex-1 px-4 py-3 rounded-lg text-sm font-mono transition-all focus:outline-none" 
						style="border: 2px solid var(--color-border); color: var(--color-text); background: var(--color-background);" 
						value={shareUrl + '?utm_source=copy&utm_medium=share&utm_campaign=share'}
						readonly
					/>
					<button 
						class="flex items-center gap-2 px-5 py-3 border-none rounded-lg font-semibold text-sm cursor-pointer transition-all hover:-translate-y-px hover:shadow-lg whitespace-nowrap" 
						style="background: var(--color-primary); color: var(--color-text-on-primary);"
						id="copy-link-btn-input"
						data-url={shareUrl + '?utm_source=copy&utm_medium=share&utm_campaign=share'}
						aria-label="Copiar link"
					>
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
							<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
						</svg>
						<span class="copy-btn-text">Copiar</span>
					</button>
				</div>
			</div>

			<!-- Seção de Redes Sociais -->
			<div class="text-sm font-semibold mb-4" style="color: var(--color-text);">Compartilhar em</div>
			<div class="grid grid-cols-3 gap-3 max-[640px]:grid-cols-2 max-[480px]:grid-cols-1">
				<!-- Instagram -->
				<a href={`https://www.instagram.com/?url=${encodeURIComponent(shareUrl + '?utm_source=instagram&utm_medium=social&utm_campaign=share')}`} target="_blank" rel="noopener" class="share-modal-link flex items-center gap-3 p-4 rounded-lg cursor-pointer transition-all hover:-translate-y-0.5 hover:shadow-lg no-underline font-medium" title="Abrir Instagram (compartilhamento via app)">
					<div class="w-10 h-10 flex items-center justify-center rounded-lg bg-gradient-to-br from-[#f09433] via-[#dc2743] to-[#bc1888] text-white shrink-0">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
							<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
						</svg>
					</div>
					<span>Instagram</span>
				</a>

				<!-- Twitter -->
				<a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(shareUrl + '?utm_source=twitter&utm_medium=social&utm_campaign=share')}&text=${encodeURIComponent(title)}`} target="_blank" rel="noopener" class="share-modal-link flex items-center gap-3 p-4 rounded-lg cursor-pointer transition-all hover:-translate-y-0.5 hover:shadow-lg no-underline font-medium" title="Compartilhar no Twitter / X">
					<div class="w-10 h-10 flex items-center justify-center rounded-lg bg-black text-white shrink-0">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
							<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
						</svg>
					</div>
					<span>Twitter / X</span>
				</a>

				<!-- Reddit -->
				<a href={`https://reddit.com/submit?url=${encodeURIComponent(shareUrl + '?utm_source=reddit&utm_medium=social&utm_campaign=share')}&title=${encodeURIComponent(title)}`} target="_blank" rel="noopener" class="share-modal-link flex items-center gap-3 p-4 rounded-lg cursor-pointer transition-all hover:-translate-y-0.5 hover:shadow-lg no-underline font-medium" title="Compartilhar no Reddit">
					<div class="w-10 h-10 flex items-center justify-center rounded-lg bg-[#FF4500] text-white shrink-0">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
							<path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .029-.463.33.33 0 0 0-.464 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.196-2.512-.73a.326.326 0 0 0-.232-.095z"/>
						</svg>
					</div>
					<span>Reddit</span>
				</a>

				<!-- WhatsApp -->
				<a href={`https://wa.me/?text=${encodeURIComponent(title + ' ' + shareUrl + '?utm_source=whatsapp&utm_medium=social&utm_campaign=share')}`} target="_blank" rel="noopener" class="share-modal-link flex items-center gap-3 p-4 rounded-lg cursor-pointer transition-all hover:-translate-y-0.5 hover:shadow-lg no-underline font-medium" title="Compartilhar no WhatsApp">
					<div class="w-10 h-10 flex items-center justify-center rounded-lg bg-[#25D366] text-white shrink-0">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
							<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
						</svg>
					</div>
					<span>WhatsApp</span>
				</a>

				<!-- Facebook -->
				<a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl + '?utm_source=facebook&utm_medium=social&utm_campaign=share')}`} target="_blank" rel="noopener" class="share-modal-link flex items-center gap-3 p-4 rounded-lg cursor-pointer transition-all hover:-translate-y-0.5 hover:shadow-lg no-underline font-medium" title="Compartilhar no Facebook">
					<div class="w-10 h-10 flex items-center justify-center rounded-lg bg-[#1877F2] text-white shrink-0">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
							<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
						</svg>
					</div>
					<span>Facebook</span>
				</a>

				<!-- LinkedIn -->
				<a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl + '?utm_source=linkedin&utm_medium=social&utm_campaign=share')}`} target="_blank" rel="noopener" class="share-modal-link flex items-center gap-3 p-4 rounded-lg cursor-pointer transition-all hover:-translate-y-0.5 hover:shadow-lg no-underline font-medium" title="Compartilhar no LinkedIn">
					<div class="w-10 h-10 flex items-center justify-center rounded-lg bg-[#0A66C2] text-white shrink-0">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
							<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
						</svg>
					</div>
					<span>LinkedIn</span>
				</a>

				<!-- Telegram -->
				<a href={`https://t.me/share/url?url=${encodeURIComponent(shareUrl + '?utm_source=telegram&utm_medium=social&utm_campaign=share')}&text=${encodeURIComponent(title)}`} target="_blank" rel="noopener" class="share-modal-link flex items-center gap-3 p-4 rounded-lg cursor-pointer transition-all hover:-translate-y-0.5 hover:shadow-lg no-underline font-medium" title="Compartilhar no Telegram">
					<div class="w-10 h-10 flex items-center justify-center rounded-lg bg-[#0088cc] text-white shrink-0">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
