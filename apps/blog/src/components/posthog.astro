---
import { getSecret } from '../lib/infisical';

const posthogKey = await getSecret('POSTHOG_KEY');
const posthogWebsite = await getSecret('POSTHOG_WEBSITE');
---
{posthogKey && (
  <meta name="posthog-key" content={posthogKey} />
  <meta name="posthog-host" content={posthogWebsite} />
  <script>
    import posthog from 'posthog-js';

    const apiKey = document.querySelector('meta[name="posthog-key"]')?.getAttribute('content');
    const apiHost = document.querySelector('meta[name="posthog-host"]')?.getAttribute('content');

    if (apiKey && apiHost && !(window as any).posthog) {
      posthog.init(apiKey, { 
        api_host: apiHost,
        person_profiles: 'identified_only',
        capture_pageview: true,
        capture_pageleave: true,
      });
      (window as any).posthog = posthog;
    }
  </script>
)}
