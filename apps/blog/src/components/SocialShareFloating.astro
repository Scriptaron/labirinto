---
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

interface Props {
	url: string;
	title: string;
}

const { url, title } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const shareUrl = url;

const translations = {
  copied: t('socialShare.copied'),
  copy: t('socialShare.copy'),
  copyError: t('socialShare.copyError'),
};
---

<!-- Botão flutuante fixo (apenas mobile) -->
<div class="lg:hidden">
	<button 
		id="floating-share-btn"
		class="floating-share-button fixed left-4 bottom-5 z-[999] w-12 h-12 rounded-lg shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-110 flex items-center justify-center border-none cursor-pointer"
		aria-label={t('socialShare.sharePostAriaLabel')}
	>
		<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<circle cx="18" cy="5" r="3"></circle>
			<circle cx="6" cy="12" r="3"></circle>
			<circle cx="18" cy="19" r="3"></circle>
			<line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
			<line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
		</svg>
	</button>

	<!-- Menu de compartilhamento -->
	<div 
		id="floating-share-menu"
		class="floating-share-backdrop fixed inset-0 z-[1001] opacity-0 invisible pointer-events-none transition-all duration-300"
		aria-hidden="true"
    data-translations={JSON.stringify(translations)}
	>
		<div class="absolute bottom-0 left-0 right-0 rounded-t-3xl shadow-2xl transform translate-y-full transition-transform duration-300 max-h-[80vh] overflow-y-auto z-[1002]" style="background: var(--color-surface);">
			<div class="sticky top-0 px-6 py-4 flex items-center justify-between z-10" style="background: var(--color-surface); border-bottom: 1px solid var(--color-border-subtle);">
				<h3 class="text-lg font-semibold m-0" style="color: var(--color-text);">{t('socialShare.modalTitle')}</h3>
				<button 
					id="floating-share-close"
					class="w-10 h-10 flex items-center justify-center rounded-full transition-colors border-none cursor-pointer bg-transparent"
					style="color: var(--color-text-muted);"
					aria-label={t('socialShare.closeAriaLabel')}
				>
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<line x1="18" y1="6" x2="6" y2="18"></line>
						<line x1="6" y1="6" x2="18" y2="18"></line>
					</svg>
				</button>
			</div>

			<div class="p-6">
				<!-- Copiar Link -->
				<div class="mb-6 pb-6" style="border-bottom: 1px solid var(--color-border-subtle);">
					<label for="floating-share-url" class="block text-sm font-semibold mb-2 share-label">{t('socialShare.postLink')}</label>
					<div class="flex gap-2">
						<input 
							type="text" 
							id="floating-share-url" 
							class="flex-1 px-4 py-3 rounded-lg text-sm font-mono" 
							style="border: 2px solid var(--color-border-subtle); color: var(--color-text); background: var(--color-background);"
							value={shareUrl + '?utm_source=copy&utm_medium=share&utm_campaign=share'}
						/>
						<button 
							id="floating-copy-btn"
							class="floating-copy-button px-5 py-3 rounded-lg font-semibold text-sm transition-all border-none cursor-pointer whitespace-nowrap"
							data-url={shareUrl + '?utm_source=copy&utm_medium=share&utm_campaign=share'}
							aria-label={t('socialShare.copyLinkAriaLabel')}
						>
							<span class="copy-text">{t('socialShare.copy')}</span>
						</button>
					</div>
				</div>

				<!-- Redes Sociais -->
				<div class="text-sm font-semibold mb-4 share-label">{t('socialShare.shareOn')}</div>
				<div class="grid grid-cols-1 gap-3">
					<!-- WhatsApp -->
					<a 
						href={`https://wa.me/?text=${encodeURIComponent(title + ' ' + shareUrl + '?utm_source=whatsapp&utm_medium=social&utm_campaign=share')}`}
						target="_blank"
						rel="noopener noreferrer"
						class="flex items-center gap-4 p-4 rounded-xl bg-[#25D366] hover:bg-[#2ee673] text-white transition-all no-underline font-medium"
					>
						<div class="w-10 h-10 flex items-center justify-center rounded-lg bg-white/20">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
								<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
							</svg>
						</div>
						<span>{t('socialShare.whatsappText')}</span>
					</a>

					<!-- Twitter/X -->
					<a 
						href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(shareUrl + '?utm_source=twitter&utm_medium=social&utm_campaign=share')}&text=${encodeURIComponent(title)}`}
						target="_blank"
						rel="noopener noreferrer"
						class="flex items-center gap-4 p-4 rounded-xl bg-black hover:bg-gray-800 text-white transition-all no-underline font-medium"
					>
						<div class="w-10 h-10 flex items-center justify-center rounded-lg bg-white/20">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
								<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
							</svg>
						</div>
						<span>{t('socialShare.twitterText')}</span>
					</a>

					<!-- Facebook -->
					<a 
						href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl + '?utm_source=facebook&utm_medium=social&utm_campaign=share')}`}
						target="_blank"
						rel="noopener noreferrer"
						class="flex items-center gap-4 p-4 rounded-xl bg-[#1877F2] hover:bg-[#0d65d9] text-white transition-all no-underline font-medium"
					>
						<div class="w-10 h-10 flex items-center justify-center rounded-lg bg-white/20">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
								<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
							</svg>
						</div>
						<span>{t('socialShare.facebookText')}</span>
					</a>

					<!-- LinkedIn -->
					<a 
						href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl + '?utm_source=linkedin&utm_medium=social&utm_campaign=share')}`}
						target="_blank"
						rel="noopener noreferrer"
						class="flex items-center gap-4 p-4 rounded-xl bg-[#0A66C2] hover:bg-[#004182] text-white transition-all no-underline font-medium"
					>
						<div class="w-10 h-10 flex items-center justify-center rounded-lg bg-white/20">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
								<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
							</svg>
						</div>
						<span>{t('socialShare.linkedinText')}</span>
					</a>

					<!-- Telegram -->
					<a 
						href={`https://t.me/share/url?url=${encodeURIComponent(shareUrl + '?utm_source=telegram&utm_medium=social&utm_campaign=share')}&text=${encodeURIComponent(title)}`}
						target="_blank"
						rel="noopener noreferrer"
						class="flex items-center gap-4 p-4 rounded-xl bg-[#0088cc] hover:bg-[#006ba1] text-white transition-all no-underline font-medium"
					>
						<div class="w-10 h-10 flex items-center justify-center rounded-lg bg-white/20">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
								<path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
							</svg>
						</div>
						<span>{t('socialShare.telegramText')}</span>
					</a>

					<!-- Instagram -->
					<a 
						href={`https://www.instagram.com/?url=${encodeURIComponent(shareUrl + '?utm_source=instagram&utm_medium=social&utm_campaign=share')}`}
						target="_blank"
						rel="noopener noreferrer"
						class="flex items-center gap-4 p-4 rounded-xl bg-gradient-to-br from-[#f09433] via-[#dc2743] to-[#bc1888] hover:from-[#f5a142] hover:via-[#e63050] hover:to-[#c72595] text-white transition-all no-underline font-medium"
						title={t('socialShare.instagramOpenTitle')}
					>
						<div class="w-10 h-10 flex items-center justify-center rounded-lg bg-white/20">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
								<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
							</svg>
						</div>
						<span>{t('socialShare.instagramText')}</span>
					</a>

					<!-- Threads -->
					<a 
						href={`https://www.threads.net/intent/post?text=${encodeURIComponent(title + ' ' + shareUrl + '?utm_source=threads&utm_medium=social&utm_campaign=share')}`}
						target="_blank"
						rel="noopener noreferrer"
						class="flex items-center gap-4 p-4 rounded-xl bg-black hover:bg-gray-800 text-white transition-all no-underline font-medium"
					>
						<div class="w-10 h-10 flex items-center justify-center rounded-lg bg-white/20">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 192 192" fill="currentColor">
								<path d="M141.537 88.9883C140.71 88.5919 139.87 88.2104 139.019 87.8451C137.537 60.5382 122.616 44.905 97.5619 44.745C97.4484 44.7443 97.3355 44.7443 97.222 44.7443C82.2364 44.7443 69.7731 51.1409 62.102 62.7807L75.881 72.2328C81.6116 63.5383 90.6052 61.6848 97.2286 61.6848C97.3051 61.6848 97.3819 61.6848 97.4576 61.6855C105.707 61.7381 111.932 64.1366 115.961 68.814C118.893 72.2193 120.854 76.925 121.825 82.8638C114.511 81.6207 106.601 81.2385 98.145 81.7233C74.3247 83.0954 59.0111 96.9879 60.0396 116.292C60.5615 126.084 65.4397 134.508 73.775 140.011C80.8224 144.663 89.899 146.938 99.3323 146.423C111.79 145.74 121.563 140.987 128.381 132.296C133.559 125.696 136.834 117.143 138.28 106.366C144.217 109.949 148.617 114.664 151.047 120.332C155.179 129.967 155.42 145.8 142.501 158.708C131.182 170.016 117.576 174.908 97.0135 175.059C74.2042 174.89 56.9538 167.575 45.7381 153.317C35.2355 139.966 29.8077 120.682 29.6052 96C29.8077 71.3178 35.2355 52.0336 45.7381 38.6827C56.9538 24.4249 74.2039 17.11 97.0132 16.9405C119.988 17.1113 137.539 24.4614 149.184 38.788C154.894 45.8136 159.199 54.6488 162.037 64.9503L178.184 60.6422C174.744 47.9622 169.331 37.0357 161.965 27.974C147.036 9.60668 125.202 0.195148 97.0695 0H96.9569C68.8816 0.19447 47.2921 9.6418 32.7883 28.0793C19.8819 44.4864 13.2244 67.3157 13.0007 95.9325L13 96L13.0007 96.0675C13.2244 124.684 19.8819 147.514 32.7883 163.921C47.2921 182.358 68.8816 191.806 96.9569 192H97.0695C122.03 191.827 139.624 185.292 154.118 170.811C173.081 151.866 172.51 128.119 166.26 113.541C161.776 103.087 153.227 94.5962 141.537 88.9883ZM98.4405 129.507C88.0005 130.095 77.1544 125.409 76.6196 115.372C76.2232 107.93 81.9158 99.626 99.0812 98.6368C101.047 98.5234 102.976 98.468 104.871 98.468C111.106 98.468 116.939 99.0737 122.242 100.233C120.264 124.935 108.662 128.946 98.4405 129.507Z"/>
							</svg>
						</div>
						<span>{t('socialShare.threadsText')}</span>
					</a>

					<!-- Reddit -->
					<a 
						href={`https://reddit.com/submit?url=${encodeURIComponent(shareUrl + '?utm_source=reddit&utm_medium=social&utm_campaign=share')}&title=${encodeURIComponent(title)}`}
						target="_blank"
						rel="noopener noreferrer"
						class="flex items-center gap-4 p-4 rounded-xl bg-[#FF4500] hover:bg-[#e03d00] text-white transition-all no-underline font-medium"
					>
						<div class="w-10 h-10 flex items-center justify-center rounded-lg bg-white/20">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
								<path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .029-.463.33.33 0 0 0-.464 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.196-2.512-.73a.326.326 0 0 0-.232-.095z"/>
							</svg>
						</div>
						<span>{t('socialShare.redditText')}</span>
					</a>

					<!-- Email -->
					<a 
						href={`mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(shareUrl + '?utm_source=email&utm_medium=social&utm_campaign=share')}`}
						class="flex items-center gap-4 p-4 rounded-xl bg-gray-600 hover:bg-gray-700 text-white transition-all no-underline font-medium"
					>
						<div class="w-10 h-10 flex items-center justify-center rounded-lg bg-white/20">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
								<polyline points="22,6 12,13 2,6"></polyline>
							</svg>
						</div>
						<span>{t('socialShare.emailText')}</span>
					</a>
				</div>
			</div>
		</div>
	</div>
</div>

<style is:global>
	/* Botão flutuante - usa primary no claro e accent no escuro */
	.floating-share-button {
		background: var(--color-primary) !important;
		color: var(--color-text-on-primary) !important;
	}

	.floating-share-button:hover {
		background: var(--color-primary-hover) !important;
	}

	:root[data-theme='dark'] .floating-share-button,
	html[data-theme='dark'] .floating-share-button {
		background: var(--accent-dark) !important;
		color: white !important;
	}

	:root[data-theme='dark'] .floating-share-button:hover,
	html[data-theme='dark'] .floating-share-button:hover {
		background: var(--accent) !important;
	}

	/* Backdrop com blur - z-index alto para cobrir tudo */
	.floating-share-backdrop {
		background: rgba(0, 0, 0, 0.6) !important;
		backdrop-filter: blur(10px) !important;
		-webkit-backdrop-filter: blur(10px) !important;
	}

	.floating-share-backdrop.opacity-100 {
		backdrop-filter: blur(10px) !important;
		-webkit-backdrop-filter: blur(10px) !important;
	}

	/* Labels com cor do tema */
	.share-label {
		color: var(--color-text) !important;
	}

	/* Botão de copiar - usa primary no claro e accent no escuro */
	.floating-copy-button {
		background: var(--color-primary) !important;
		color: var(--color-text-on-primary) !important;
	}

	.floating-copy-button:hover {
		background: var(--color-primary-hover) !important;
	}

	:root[data-theme='dark'] .floating-copy-button,
	html[data-theme='dark'] .floating-copy-button {
		background: var(--color-accent) !important;
		color: var(--neutral-900) !important;
	}

	:root[data-theme='dark'] .floating-copy-button:hover,
	html[data-theme='dark'] .floating-copy-button:hover {
		background: var(--color-accent-hover) !important;
	}

	/* Hover no botão de fechar */
	#floating-share-close:hover {
		background: var(--color-border-subtle) !important;
	}

	/* Painel de compartilhamento - fundo escuro no tema escuro */
	:root[data-theme='dark'] #floating-share-menu > div,
	html[data-theme='dark'] #floating-share-menu > div {
		background: #1a1a1a !important;
	}

	:root[data-theme='dark'] #floating-share-menu > div > div,
	html[data-theme='dark'] #floating-share-menu > div > div {
		background: #1a1a1a !important;
		border-bottom-color: rgba(255, 255, 255, 0.1) !important;
	}
</style>

<script>
	function initFloatingShare() {
		const btn = document.getElementById('floating-share-btn');
		const menu = document.getElementById('floating-share-menu');
		const closeBtn = document.getElementById('floating-share-close');
		const copyBtn = document.getElementById('floating-copy-btn');
		const mobileMenuOverlay = document.getElementById('mobile-menu-overlay');

		if (!btn || !menu || !closeBtn) return;

		// Esconder botão quando menu mobile estiver aberto
		if (mobileMenuOverlay) {
			const observer = new MutationObserver(() => {
				if (mobileMenuOverlay.classList.contains('open')) {
					btn.style.display = 'none';
				} else {
					btn.style.display = 'flex';
				}
			});

			observer.observe(mobileMenuOverlay, {
				attributes: true,
				attributeFilter: ['class']
			});
		}

		const openMenu = () => {
			menu.classList.remove('opacity-0', 'invisible', 'pointer-events-none');
			menu.classList.add('opacity-100', 'pointer-events-auto');
			menu.setAttribute('aria-hidden', 'false');
			const panel = menu.querySelector('div');
			if (panel) {
				panel.classList.remove('translate-y-full');
			}
			document.body.style.overflow = 'hidden';
			// Esconder o botão quando o menu estiver aberto
			btn.style.opacity = '0';
			btn.style.pointerEvents = 'none';
			// Aplicar blur e overlay na barra de progresso
			const progressBar = document.getElementById('reading-progress-container');
			if (progressBar) {
				progressBar.style.backdropFilter = 'blur(4px)';
				progressBar.style.webkitBackdropFilter = 'blur(4px)';
				progressBar.classList.add('modal-open');
			}
		};

		const closeMenu = () => {
			menu.classList.add('opacity-0', 'invisible', 'pointer-events-none');
			menu.classList.remove('opacity-100', 'pointer-events-auto');
			menu.setAttribute('aria-hidden', 'true');
			const panel = menu.querySelector('div');
			if (panel) {
				panel.classList.add('translate-y-full');
			}
			document.body.style.overflow = '';
			// Mostrar o botão novamente quando o menu fechar
			btn.style.opacity = '1';
			btn.style.pointerEvents = 'auto';
			// Remover blur e overlay da barra de progresso
			const progressBar = document.getElementById('reading-progress-container');
			if (progressBar) {
				progressBar.style.backdropFilter = '';
				progressBar.style.webkitBackdropFilter = '';
				progressBar.classList.remove('modal-open');
			}
		};

		btn.addEventListener('click', openMenu);
		closeBtn.addEventListener('click', closeMenu);
		
		// Fechar ao clicar no backdrop
		menu.addEventListener('click', (e) => {
			if (e.target === menu) {
				closeMenu();
			}
		});

		// Copiar link
		if (copyBtn) {
			copyBtn.addEventListener('click', async () => {
				const url = copyBtn.getAttribute('data-url');
				if (!url) return;

				try {
					await navigator.clipboard.writeText(url);
					const span = copyBtn.querySelector('.copy-text');
					if (span) {
						const originalText = span.textContent;
						span.textContent = 'Copiado!';
						setTimeout(() => {
							span.textContent = originalText || 'Copiar';
						}, 2000);
					}
				} catch (err) {
					console.error('Erro ao copiar:', err);
				}
			});
		}
	}

	document.addEventListener('DOMContentLoaded', initFloatingShare);
	document.addEventListener('astro:page-load', initFloatingShare);
</script>