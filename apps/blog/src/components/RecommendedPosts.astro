---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { categories } from '@/content.config';

interface Props {
  posts: CollectionEntry<'blog'>[];
  locale: 'pt' | 'es' | 'en';
  class?: string;
}

const { posts, locale, class: className } = Astro.props;
---

<div class={`recommended-posts-wrapper ${className || ''}`}>
  <h3 class="text-lg font-bold text-text mb-4 pl-1 uppercase tracking-wider">
    {locale === 'pt' ? 'Recomendados para você' : locale === 'es' ? 'Recomendado para ti' : 'Recommended for you'}
  </h3>
  <div class="grid gap-3 md:gap-4 grid-cols-1">
    {posts.map(post => {
      const categoryId = post.data.category;
      const categoryData = categoryId ? Object.values(categories).find(c => c.id === categoryId || c.slug === categoryId) : null;
      const categoryName = categoryData?.name[locale] || (categoryId ? categoryId.charAt(0).toUpperCase() + categoryId.slice(1) : 'Geral');
      
      return (
      <a 
        href={`/${locale}/blog/${post.data.permalink}?ref=blog_recommendation`} 
        class="recommended-post-card group block rounded-xl border border-border-subtle transition-shadow hover:shadow-md overflow-hidden no-underline"
        data-permalink={post.data.permalink}
      >
        {post.data.heroImage && (
          <div class="w-full h-40 overflow-hidden relative">
            <Image 
              src={post.data.heroImage} 
              alt={post.data.title} 
              width={400} 
              height={225} 
              class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105 rounded-none m-0 block" 
            />
          </div>
        )}
        <div class="px-3 pb-3 pt-2 md:px-4 md:pb-4 md:pt-3 flex flex-col gap-1.5 md:gap-2">
          <span class="text-[0.65rem] font-semibold text-text-muted uppercase tracking-wide">
            {categoryName}
          </span>
          <h4 class="text-sm font-semibold text-text group-hover:text-blog-highlight transition-colors line-clamp-2 leading-snug">
            {post.data.title}
          </h4>
        </div>
      </a>
      );
    })}
  </div>
</div>

<style>
  .recommended-post-card {
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-border-subtle);
  }

  :global([data-theme="dark"]) .recommended-post-card {
    background: var(--shiki-dark-bg);
    border: 1px solid var(--color-border-subtle);
  }
</style>
