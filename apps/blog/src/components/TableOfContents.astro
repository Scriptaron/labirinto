---
// Table of Contents Component
---

<aside class="toc-sidebar">
	<nav class="toc-nav">
		<h3 class="toc-title">Navegação Rápida:</h3>
		<ul class="toc-list" id="toc-list">
			<!-- TOC items will be populated by JavaScript -->
		</ul>
	</nav>
</aside>

<script is:inline>
	function initTOC() {
		const tocList = document.getElementById('toc-list');
		const tocSidebar = document.querySelector('.toc-sidebar');
		const article = document.querySelector('article');
		
		console.log('TOC Init:', { tocList, tocSidebar, article });
		
		if (!tocList || !tocSidebar || !article) return;

		// Find all h2 elements with IDs in the article
		const headings = article.querySelectorAll('h2[id]');
		
		console.log('Headings found:', headings.length);
		
		if (headings.length === 0) {
			tocSidebar.style.display = 'none';
			return;
		}

		// Generate TOC items
		headings.forEach((heading, index) => {
			const li = document.createElement('li');
			li.className = 'toc-item';
			
			const a = document.createElement('a');
			a.href = `#${heading.id}`;
			a.className = 'toc-link';
			
			const textSpan = document.createElement('span');
			textSpan.className = 'toc-text';
			textSpan.textContent = heading.textContent || '';
			
			const number = document.createElement('span');
			number.className = 'toc-number';
			number.textContent = (index + 1).toString();
			
			a.appendChild(textSpan);
			a.appendChild(number);
			li.appendChild(a);
			tocList.appendChild(li);
			
			console.log('Added TOC item:', heading.textContent, 'Number:', index + 1);
		});

		// Scroll spy
		function updateActiveTocItem() {
			if (!tocList) return;
			
			let current = '';
			const scrollPosition = window.scrollY + 150;

			headings.forEach((heading) => {
				const headingTop = heading.offsetTop;
				const id = heading.getAttribute('id');
				
				if (scrollPosition >= headingTop && id) {
					current = id;
				}
			});

			const tocLinks = tocList.querySelectorAll('.toc-link');
			tocLinks.forEach((link) => {
				link.classList.remove('active');
			});

			if (current) {
				const activeLink = tocList.querySelector(`.toc-link[href="#${current}"]`);
				if (activeLink) {
					activeLink.classList.add('active');
					
					// Auto-scroll do TOC para manter o item ativo visível
					const tocSidebarElement = document.querySelector('.toc-sidebar');
					if (tocSidebarElement) {
						const linkRect = activeLink.getBoundingClientRect();
						const sidebarRect = tocSidebarElement.getBoundingClientRect();
						
						// Verifica se o link está fora da área visível
						if (linkRect.top < sidebarRect.top || linkRect.bottom > sidebarRect.bottom) {
							// Descobre a posição do item na lista
							const allLinks = Array.from(tocList.querySelectorAll('.toc-link'));
							const currentIndex = allLinks.indexOf(activeLink);
							const isFirst = currentIndex === 0;
							const isLast = currentIndex === allLinks.length - 1;
							
							// Scroll apropriado baseado na posição
							if (isFirst) {
								activeLink.scrollIntoView({ behavior: 'smooth', block: 'start' });
							} else if (isLast) {
								activeLink.scrollIntoView({ behavior: 'smooth', block: 'end' });
							} else {
								activeLink.scrollIntoView({ behavior: 'smooth', block: 'center' });
							}
						}
					}
				}
			}
		}

		// Throttle com requestAnimationFrame
		let ticking = false;
		function requestTick() {
			if (!ticking) {
				requestAnimationFrame(() => {
					updateActiveTocItem();
					ticking = false;
				});
				ticking = true;
			}
		}

		window.addEventListener('scroll', requestTick);
		setTimeout(updateActiveTocItem, 100);

		// Smooth scroll
		tocList.querySelectorAll('.toc-link').forEach((link) => {
			link.addEventListener('click', (e) => {
				e.preventDefault();
				const targetId = link.getAttribute('href')?.slice(1);
				const target = document.getElementById(targetId || '');
				if (target) {
					target.scrollIntoView({ behavior: 'smooth', block: 'start' });
				}
			});
		});
	}

	document.addEventListener('DOMContentLoaded', initTOC);
	document.addEventListener('astro:page-load', initTOC);
</script>

<style is:global>
	.toc-sidebar {
		position: sticky;
		top: 2rem;
		width: 260px;
		max-height: calc(68vh - 4rem);
		align-self: flex-start;
		flex-shrink: 0;
		overflow-y: auto;
		scrollbar-width: none;
		-ms-overflow-style: none;
	}

	.toc-sidebar::-webkit-scrollbar {
		display: none;
	}

	@media (max-width: 1024px) {
		.toc-sidebar {
			display: none;
		}
	}

	.toc-nav {
		background: #1a1a1a;
		border-radius: 0.75rem;
		padding: 1.5rem;
		box-shadow: var(--shadow-lg);
	}

	:root:not([data-theme="dark"]) .toc-nav {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
	}

	.toc-title {
		color: white;
		font-size: 1.25rem;
		font-weight: 600;
		margin: 0 0 1.5rem 0;
		padding: 0;
	}

	:root:not([data-theme="dark"]) .toc-title {
		color: var(--color-text);
	}

	.toc-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.toc-item {
		margin: 0;
	}

	.toc-link {
		text-decoration: none;
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.75rem 1rem;
		font-size: 0.9375rem;
		border-radius: 0.5rem;
		transition: all 0.2s ease;
		gap: 0.75rem;
		color: #9ca3af;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid transparent;
	}

	:root:not([data-theme="dark"]) .toc-link {
		color: var(--color-text-muted);
		background: var(--color-border-subtle);
	}

	.toc-link:hover {
		color: #d1d5db;
		background: rgba(255, 255, 255, 0.05);
		border-color: rgba(255, 255, 255, 0.1);
	}

	:root:not([data-theme="dark"]) .toc-link:hover {
		color: var(--color-text);
		background: var(--color-border);
		border-color: var(--color-border);
	}

	.toc-link:hover .toc-number {
		color: white;
		background: var(--accent-dark);
		border-color: var(--accent-dark);
		transform: scale(1.05);
	}

	:root:not([data-theme="dark"]) .toc-link:hover .toc-number {
		color: white;
		background: var(--primary-light);
		border-color: var(--primary-light);
	}

	.toc-link.active {
		color: var(--accent-dark);
		background: color-mix(in srgb, var(--accent-dark) 15%, transparent);
		border-color: color-mix(in srgb, var(--accent-dark) 35%, transparent);
	}

	:root:not([data-theme="dark"]) .toc-link.active {
		color: var(--primary);
		background: color-mix(in srgb, var(--primary) 12%, transparent);
		border-color: color-mix(in srgb, var(--primary) 30%, transparent);
	}

	.toc-link.active .toc-number {
		color: white;
		background: var(--accent-dark);
		border-color: var(--accent-dark);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent-dark) 25%, transparent);
	}

	:root:not([data-theme="dark"]) .toc-link.active .toc-number {
		color: white;
		background: var(--primary);
		border-color: var(--primary);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 20%, transparent);
	}

	.toc-text {
		flex: 1;
		line-height: 1.4;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		text-overflow: ellipsis;
		max-height: calc(1.4em * 2);
	}

	.toc-number {
		font-size: 0.875rem;
		font-weight: 700;
		padding: 0.35rem 0.6rem;
		border-radius: 0.375rem;
		min-width: 1.85rem;
		height: 1.85rem;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		flex-shrink: 0;
		transition: all 0.2s ease;
		color: #6b7280;
		background: rgba(255, 255, 255, 0.1);
		border: 1px solid rgba(255, 255, 255, 0.15);
	}

	:root:not([data-theme="dark"]) .toc-number {
		color: var(--color-text-muted);
		background: var(--color-border);
		border-color: var(--color-border);
	}
</style>
