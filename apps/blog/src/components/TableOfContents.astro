---
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<aside class="toc-sidebar">
	<nav class="toc-nav">
		<h3 class="toc-title">{t('toc.title')}</h3>
		<ul class="toc-list" id="toc-list">
			<!-- TOC items will be populated by JavaScript -->
		</ul>
	</nav>
</aside>

<script is:inline>
	function initTOC() {
		const tocList = document.getElementById('toc-list');
		const tocSidebar = document.querySelector('.toc-sidebar');
		const article = document.querySelector('article');
		
		if (!tocList || !tocSidebar || !article) return;

		// Find all h2 elements with IDs in the article, excluding footnotes
		const headings = Array.from(article.querySelectorAll('h2[id]'))
			.filter(heading => heading.id !== 'footnote-label');
		
		if (headings.length === 0) {
			tocSidebar.style.display = 'none';
			return;
		}

		// Clear and rebuild TOC
		tocList.innerHTML = '';
		const linkMap = new Map();

		headings.forEach((heading, index) => {
			const li = document.createElement('li');
			li.className = 'toc-item';
			
			const a = document.createElement('a');
			a.href = `#${heading.id}`;
			a.className = 'toc-link';
			
			const textSpan = document.createElement('span');
			textSpan.className = 'toc-text';
			textSpan.textContent = heading.textContent || '';
			
			const number = document.createElement('span');
			number.className = 'toc-number';
			number.textContent = (index + 1).toString();
			
			a.appendChild(number);
			a.appendChild(textSpan);
			li.appendChild(a);
			tocList.appendChild(li);
			
			linkMap.set(heading.id, a);
			
			// Smooth scroll click handler
			a.addEventListener('click', (e) => {
				e.preventDefault();
				const target = document.getElementById(heading.id);
				if (target) {
					target.scrollIntoView({ behavior: 'smooth', block: 'start' });
					history.pushState(null, null, `#${heading.id}`);
				}
			});
		});

		// IntersectionObserver for active section detection
		// rootMargin creates a "reading zone" at the top of the viewport
		const observerOptions = {
			root: null,
			rootMargin: '-100px 0px -70% 0px',
			threshold: 0
		};

		const observer = new IntersectionObserver((entries) => {
			entries.forEach(entry => {
				if (entry.isIntersecting) {
					setActiveLink(entry.target.id);
				}
			});
		}, observerOptions);

		headings.forEach(heading => observer.observe(heading));

		// Handle bottom of page case
		window.addEventListener('scroll', () => {
			if ((window.innerHeight + window.scrollY) >= document.body.offsetHeight - 50) {
				if (headings.length > 0) {
					setActiveLink(headings[headings.length - 1].id);
				}
			}
		});

		let activeLink = null;

		function setActiveLink(id) {
			const newLink = linkMap.get(id);
			if (!newLink || newLink === activeLink) return;

			if (activeLink) activeLink.classList.remove('active');
			newLink.classList.add('active');
			activeLink = newLink;

			updateSidebarScroll(newLink);
		}

		function updateSidebarScroll(link) {
			if (!tocList) return;
			
			const listRect = tocList.getBoundingClientRect();
			const linkRect = link.getBoundingClientRect();

			// Always scroll to center the active link
			const scrollTop = tocList.scrollTop;
			const linkTopRelative = linkRect.top - listRect.top;
			const targetScroll = scrollTop + linkTopRelative - (listRect.height / 2) + (linkRect.height / 2);
			
			tocList.scrollTo({
				top: targetScroll,
				behavior: 'smooth'
			});
		}
	}

	document.addEventListener('DOMContentLoaded', initTOC);
	document.addEventListener('astro:page-load', initTOC);
</script>

<style is:global>
	.toc-sidebar {
		width: 100%;
		flex-shrink: 0;
	}

	@media (max-width: 1024px) {
		.toc-sidebar {
			display: none;
		}
	}

	.toc-nav {
		background: var(--shiki-dark-bg);
		border-radius: 0.75rem;
		padding: 1.25rem;
		box-shadow: var(--shadow-lg);
		display: flex;
		flex-direction: column;
		max-height: 60vh;
		border: 1px solid var(--color-border-subtle);
	}

	:root:not([data-theme="dark"]) .toc-nav {
		background: var(--color-surface);
		border: 1px solid var(--color-border-subtle);
	}

	.toc-title {
		color: white;
		font-size: 1.125rem;
		font-weight: 600;
		margin: 0 0 1rem 0;
		padding: 0;
		flex-shrink: 0;
	}

	:root:not([data-theme="dark"]) .toc-title {
		color: var(--color-text);
	}

	.toc-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		overflow-y: auto;
		scrollbar-width: none;
		-ms-overflow-style: none;
	}

	.toc-list::-webkit-scrollbar {
		display: none;
	}

	.toc-item {
		margin: 0;
	}

	.toc-link {
		text-decoration: none;
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.625rem 0.875rem;
		font-size: 0.875rem;
		border-radius: 0.5rem;
		transition: all 0.2s ease;
		gap: 0.75rem;
		color: var(--color-text-muted);
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid transparent;
	}

	:root:not([data-theme="dark"]) .toc-link {
		color: var(--color-text-muted);
		background: var(--color-border-subtle);
	}

	.toc-link:hover {
		color: var(--color-text);
		background: rgba(255, 255, 255, 0.05);
		border-color: rgba(255, 255, 255, 0.1);
	}

	:root:not([data-theme="dark"]) .toc-link:hover {
		color: var(--color-text);
		background: var(--color-border);
		border-color: var(--color-border-subtle);
	}

	.toc-link:hover .toc-number {
		color: white;
		background: var(--accent-dark);
		border-color: var(--accent-dark);
		transform: scale(1.05);
	}

	:root:not([data-theme="dark"]) .toc-link:hover .toc-number {
		color: white;
		background: var(--primary-light);
		border-color: var(--primary-light);
	}

	.toc-link.active {
		color: var(--accent-dark);
		background: color-mix(in srgb, var(--accent-dark) 15%, transparent);
		border-color: color-mix(in srgb, var(--accent-dark) 35%, transparent);
	}

	:root:not([data-theme="dark"]) .toc-link.active {
		color: var(--primary);
		background: color-mix(in srgb, var(--primary) 12%, transparent);
		border-color: color-mix(in srgb, var(--primary) 30%, transparent);
	}

	.toc-link.active .toc-number {
		color: white;
		background: var(--accent-dark);
		border-color: var(--accent-dark);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent-dark) 25%, transparent);
	}

	:root:not([data-theme="dark"]) .toc-link.active .toc-number {
		color: white;
		background: var(--primary);
		border-color: var(--primary);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 20%, transparent);
	}

	.toc-text {
		flex: 1;
		line-height: 1.4;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		text-overflow: ellipsis;
		max-height: calc(1.4em * 2);
	}

	.toc-number {
		font-size: 0.8125rem;
		font-weight: 700;
		padding: 0.25rem 0.5rem;
		border-radius: 0.375rem;
		min-width: 1.75rem;
		height: 1.75rem;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		flex-shrink: 0;
		transition: all 0.2s ease;
		color: var(--color-text-muted);
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid var(--color-border-subtle);
	}

	:root:not([data-theme="dark"]) .toc-number {
		color: var(--color-text-muted);
		background: var(--color-border);
		border-color: var(--color-border-subtle);
	}
</style>
