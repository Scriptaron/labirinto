# =============================================================================
# Docker Compose Profile Configuration
# =============================================================================
# Este arquivo suporta dois perfis de execução:
#
# 1. PROFILE: selfhosted (padrão)
#    - Roda Infisical self-hosted localmente com PostgreSQL e Redis
#    - Comandos: make compose-selfhosted-start / make compose-selfhosted-stop
#    - Requer: ENCRYPTION_KEY, AUTH_SECRET, POSTGRES_*
#
# 2. PROFILE: cloud
#    - Usa Infisical Cloud (app.infisical.com)
#    - Comandos: make compose-cloud-start / make compose-cloud-stop
#    - Requer apenas: NEXT_PUBLIC_INFISICAL_URL, PUBLIC_INFISICAL_URL
#
# =============================================================================

# -----------------------------------------------------------------------------
# Infisical Self-Hosted Configuration (apenas para profile: selfhosted)
# -----------------------------------------------------------------------------
# IMPORTANTE: Gere valores seguros para produção!
# Exemplo: openssl rand -base64 32
ENCRYPTION_KEY=your-encryption-key-here-min-32-chars
AUTH_SECRET=your-auth-secret-here-min-32-chars
INFISICAL_SITE_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Infisical URLs (ambos profiles)
# -----------------------------------------------------------------------------
# Para selfhosted: apontar para http://localhost:8080
# Para cloud: apontar para https://app.infisical.com
NEXT_PUBLIC_INFISICAL_URL=http://localhost:8080
PUBLIC_INFISICAL_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# PostgreSQL Configuration (apenas para profile: selfhosted)
# -----------------------------------------------------------------------------
# Credenciais do banco de dados para Infisical self-hosted
# AVISO: Use valores seguros em produção!
POSTGRES_USER=infisical
POSTGRES_PASSWORD=infisical
POSTGRES_DB=infisical

# -----------------------------------------------------------------------------
# Application URLs (ambos profiles)
# -----------------------------------------------------------------------------
# URL interna do blog (comunicação entre containers)
BLOG_URL=http://blog:4321

# URLs públicas para acesso externo (ajustar para domínio em produção)
NEXT_PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_BLOG_URL=http://localhost:4321
